# Neon Postgres 연결 문자열 (프로젝트별 별도 DB)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 관리자(맵 데이터 유지보수) JWT 서명 키 — 운영 배포 시 반드시 임의의 긴 값으로 교체
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# developer.pubg.com 에서 발급하는 Bearer API 키 — 절대 커밋 금지
PUBG_API_KEY=""

PORT=3000

# 프론트 오리진 (CORS 허용, Vercel URL)
# 여러 개는 콤마로 구분(예: https://a.vercel.app,https://b.vercel.app)
CORS_ORIGIN="http://localhost:5173"
